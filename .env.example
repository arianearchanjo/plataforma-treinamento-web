# Conexão PostgreSQL local (ajuste usuário/senha/porta conforme seu ambiente)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plataforma_treinamento?schema=public"

# Segredo usado pelo Better-Auth para assinar sessões.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="troque-este-segredo-em-producao"

# URL pública da aplicação
BETTER_AUTH_URL="http://localhost:3000"
